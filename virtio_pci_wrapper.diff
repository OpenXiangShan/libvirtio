+static int virtio_pci_dev_config_read(uint32_t offset, void *dst, int len, void *priv)
+{
+	struct virtio_pci_dev *pdev = priv;
+	uint8_t *buf = dst;
+	int chunk;
+
+	if (!pdev || !dst || len <= 0 || len > 4)
+		return -1;
+
+	memset(dst, 0, len);
+
+	if (offset < sizeof(pdev->header)) {
+		chunk = sizeof(pdev->header) - offset;
+		if (chunk > len)
+			chunk = len;
+
+		memcpy(buf, ((uint8_t *)&pdev->header) + offset, chunk);
+		buf += chunk;
+		len -= chunk;
+		offset = 0;
+	} else {
+		offset -= sizeof(pdev->header);
+	}
+
+	if (!len)
+		return 0;
+
+	/*
